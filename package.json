{
  "name": "group-taste-match",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "pnpm cf-typegen && tsc -b",
    "cf-typegen": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "test:watch": "vitest",
    "exp:labels": "tsx experiment/scripts/labels.ts",
    "exp:freeze": "tsx experiment/scripts/freeze-inputs.ts",
    "exp:run": "tsx experiment/scripts/run.ts",
    "exp:judge": "tsx experiment/scripts/judge.ts",
    "exp:analyze": "tsx experiment/scripts/analyze.ts",
    "exp:packet": "tsx experiment/scripts/review-packet.ts",
    "review": "node experiment/review/server.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/playfair-display": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
