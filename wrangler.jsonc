{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "group-taste-match",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // "live" calls Workers AI; set PROVIDER_MODE=fixture in .dev.vars for offline UI work.
    "PROVIDER_MODE": "live",
    // Provisional default from exp-v1 (see Beli_Group_Explore_Experiment_Report.md):
    // automated quality tied; blinded human A/B preferred the baseline 15–5. Clef stays available.
    "DECISION_METHOD": "llm_baseline",
    "AI_GATEWAY_ID": "group-taste-match"
  },
  "observability": { "enabled": true }
}
