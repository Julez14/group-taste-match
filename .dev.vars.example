# Copy to .dev.vars for local overrides; never commit .dev.vars.
# fixture = canned decisions for UI work; live = Workers AI through AI Gateway.
PROVIDER_MODE=fixture
# clef | llm_baseline
DECISION_METHOD=clef
# AI Gateway id used in live mode
AI_GATEWAY_ID=group-taste-match

# For local experiment and trace routes only; never deploy with this enabled.
# DEV_ROUTES=on
